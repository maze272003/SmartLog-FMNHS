{
  "name": "fmnhs-qr",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "concurrently -n \"convex,next\" -c \"magenta,cyan\" \"convex dev\" \"next dev\"",
    "dev:convex": "convex dev",
    "dev:next": "next dev",
    "typecheck": "tsc --noEmit",
    "build": "npm run typecheck && next build",
    "start": "next start",
    "lint": "eslint . --ignore-pattern \"convex/_generated/**\"",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "convex": "^1.44.0",
    "jsqr": "^1.4.0",
    "lucide-react": "^1.61.0",
    "next": "16.3.8",
    "qrcode": "^1.5.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@convex-dev/eslint-plugin": "^5.0.0",
    "@edge-runtime/vm": "^5.0.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^24.13.3",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@typescript/native": "npm:typescript@^7.0.2",
    "concurrently": "^10.0.6",
    "convex-test": "^0.0.65",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.3.0",
    "jsdom": "^30.1.3",
    "prettier": "^3.9.6",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "vitest": "^5.0.5"
  }
}
